{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "__PIXEL_QUEST_HOME__/hook codex UserPromptSubmit", "timeout": 5 }] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "__PIXEL_QUEST_HOME__/hook codex PreToolUse", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "__PIXEL_QUEST_HOME__/hook codex PostToolUse", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "__PIXEL_QUEST_HOME__/hook codex Stop", "timeout": 5 }] }
    ]
  }
}
